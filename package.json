{
  "name": "clarity-codegen",
  "version": "1.1.4",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "files": [
    "lib/"
  ],
  "license": "MIT",
  "bin": {
    "clarity-codegen": "./lib/generate/cli.js"
  },
  "scripts": {
    "prepare": "pnpm run build",
    "build": "rm -rf lib && tsup-node src"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "./generate": {
      "types": "./lib/generate/index.d.ts",
      "import": "./lib/generate/index.mjs",
      "require": "./lib/generate/index.js"
    },
    "./lib/generate": {
      "types": "./lib/generate/index.d.ts",
      "import": "./lib/generate/index.mjs",
      "require": "./lib/generate/index.js"
    }
  },
  "devDependencies": {
    "@stacks/common": "^7.0.2",
    "@stacks/transactions": "^7.0.2",
    "@types/lodash": "^4.14.194",
    "@types/node": "^20.1.5",
    "@types/yargs": "^17.0.24",
    "prettier": "^2.8.8",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@stacks/stacks-blockchain-api-types": "^7.1.10",
    "axios": "^1.6.0",
    "lodash": "^4.17.21",
    "yargs": "^17.7.2",
    "yqueue": "^1.0.1"
  },
  "peerDependencies": {
    "@stacks/common": "^7.0.2",
    "@stacks/transactions": "^7.0.2"
  }
}
